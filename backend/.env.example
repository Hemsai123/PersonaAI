# ==========================================
# Core Django Settings
# ==========================================
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# Database Configuration (MySQL)
# Leave DB_NAME and DB_USER blank to fallback to SQLite automatically
# ==========================================
DB_NAME=persona_ai
DB_USER=root
DB_PASSWORD=hemsai707
DB_HOST=localhost
DB_PORT=3306

# ==========================================
# AI Model Inference (Gemini or Groq)
# ==========================================
# Google Gemini API Key (get from https://aistudio.google.com/apikey):
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Groq API Key (alternative from https://console.groq.com/keys):
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# ==========================================
# Generative Video & Avatars (Fal.ai & HeyGen)
# ==========================================
FAL_KEY=your_fal_ai_api_key
HEYGEN_API_KEY=your_heygen_api_key
HEYGEN_API_BASE=https://api.heygen.ai
DEFAULT_HEYGEN_AVATAR_ID=
DEFAULT_HEYGEN_VOICE_ID=

# ==========================================
# Third-Party Media & Voice APIs
# ==========================================
PEXELS_API_KEY=your_pexels_api_key
HF_API_TOKEN=your_huggingface_token
REPLICATE_API_TOKEN=your_replicate_token
DEEPGRAM_API_KEY=your_deepgram_api_key
