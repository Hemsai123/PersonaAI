# ==========================================
# Core Django Settings
# ==========================================
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# Database Configuration (MySQL)
# Leave DB_NAME and DB_USER blank to fallback to SQLite automatically
# ==========================================
DB_NAME=persona_ai
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# ==========================================
# AI Model Inference (Groq)
# Get your API key at: https://console.groq.com/keys
# ==========================================
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=compound-beta
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# ==========================================
# Generative Video & Avatars (Fal.ai & HeyGen)
# ==========================================
FAL_KEY=your_fal_ai_api_key
HEYGEN_API_KEY=your_heygen_api_key
HEYGEN_API_BASE=https://api.heygen.ai
DEFAULT_HEYGEN_AVATAR_ID=
DEFAULT_HEYGEN_VOICE_ID=

# ==========================================
# Third-Party Media & Voice APIs
# ==========================================
PEXELS_API_KEY=your_pexels_api_key
HF_API_TOKEN=your_huggingface_token
REPLICATE_API_TOKEN=your_replicate_token
DEEPGRAM_API_KEY=your_deepgram_api_key

