# ==========================================
# PersonaAI Frontend Environment Variables
# ==========================================

# Base API URL (Leave blank to use Vite development proxy on :5173 -> :8787)
VITE_API_BASE_URL=

# Deepgram API Key (Optional: for high-quality Aura TTS models)
VITE_DEEPGRAM_API_KEY=

# ScrapingBee API Key (Optional: for Google Search persona synthesis)
VITE_SCRAPING_BEE_API_KEY=

# Apify API Token (Optional: for social media intelligence)
VITE_APIFY_API_TOKEN=

